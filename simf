#!/usr/bin/env bash
# Config
sfversion="V1.1.0"
# Traps
trap "echo ERR 403" SIGINT
trap "echo ERR 403" SIGTERM
# Vars
whoami=$(whoami)
pwd=$(pwd)
arch=$(arch)
uname=$(uname -o)
oss=$(lsb_release -sd 2>/dev/null)
# Display
echo SimpleFetch $sfversion...
echo whoami= $whoami
echo pwd= $pwd
echo arch= $arch
echo uname= $uname
echo lsb_release= $oss
